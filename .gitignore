# RESPONSIBILITY: .gitignore
# ----------------------------
# Tells Git which files/folders to NOT track.
# Keeps sensitive data, large files, and environment files out of the repo.

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
dist/
build/
*.so

# Virtual environment
venv/
.env
.venv/
env/

# Data files (tracked by DVC instead)
data/raw/*.csv
data/processed/*.csv

# Model artifacts (tracked by DVC)
artifacts/

# MLflow
mlruns/
mlflow.db

# DVC
.dvc/cache/
.dvc/tmp/

# Logs
logs/
*.log

# Jupyter
.ipynb_checkpoints/
*.ipynb~

# Docker
*.tar

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

